            <mxPoint x="170" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. Deliver advice to patient, mark delivered — no doctor, no waiting" style="endArrow=block;html=1;fontSize=11;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1">
