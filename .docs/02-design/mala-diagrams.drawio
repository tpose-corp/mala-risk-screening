        </mxCell>
        <mxCell id="note1" value="Hospital manages the patient directly.&#xa;No advice is sent back for staff to carry out." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
